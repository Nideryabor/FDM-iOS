# ============================================================
#  ios-port · 本机私密配置模板
#
#  复制成 .env 再改 —— .env 不进版本库（见 .gitignore）。
#
#    cp .env.example .env
#    chmod 600 .env
#    $EDITOR .env
#
#  ★ 脚本里不含任何口令，全部从 .env 读；
#    缺关键项会直接报错退出，绝不回退到内置默认口令。
# ============================================================

# ---- 手机（越狱 iOS）----
IPHONE_HOST=192.168.1.8
IPHONE_PORT=2222
IPHONE_USER=mobile
# ★ 必填：SSH 口令
IPHONE_PW=换成你的密码

# ---- ios-mcp（设备上的 MCP 服务；不可用就留默认，脚本会自动走 SSH）----
IOS_MCP_HOST=192.168.1.8
IOS_MCP_PORT=8090

# ---- 宿主 App 的沙盒路径 ----
#   App 重装会变（UUID 那一段），变了改这里
#   找法：ls -t /var/mobile/Containers/Data/Application/ | head -1
APP_DOCS=/var/mobile/Containers/Data/Application/<容器UUID>/Documents
